generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

enum UserRole {
  STAFF
  ADMIN
  EXECUTIVE
}

enum RequestStatus {
  NEW
  RECEIVED
  UNDER_REVIEW
  IN_PROGRESS
  COMPLETED
  CLOSED
  REJECTED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  fullName     String
  role         UserRole
  departmentId String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department    Department?            @relation(fields: [departmentId], references: [id])
  statusHistory RequestStatusHistory[]
  staffNotes    StaffNote[]
  auditLogs     AuditLog[]
}

model Department {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())

  users    User[]
  requests Request[]
}

model RequestCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  requests Request[]
}

model Request {
  id                   String        @id @default(cuid())
  trackingNumber       String        @unique
  citizenName          String
  citizenPhone         String
  citizenEmail         String?
  categoryId           String
  title                String
  description          String
  attachmentPath       String?
  currentStatus        RequestStatus @default(NEW)
  assignedDepartmentId String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  closedAt             DateTime?

  category           RequestCategory       @relation(fields: [categoryId], references: [id])
  assignedDepartment Department?           @relation(fields: [assignedDepartmentId], references: [id])
  attachments        RequestAttachment[]
  statusHistory      RequestStatusHistory[]
  staffNotes         StaffNote[]

  @@index([currentStatus])
  @@index([createdAt])
  @@index([categoryId])
  @@index([assignedDepartmentId])
}

model RequestAttachment {
  id         String   @id @default(cuid())
  requestId  String
  fileName   String
  filePath   String
  mimeType   String
  fileSize   Int
  uploadedAt DateTime @default(now())

  request Request @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
}

model RequestStatusHistory {
  id              String         @id @default(cuid())
  requestId        String
  previousStatus   RequestStatus?
  newStatus        RequestStatus
  changedByUserId  String?
  note             String?
  changedAt        DateTime       @default(now())

  request       Request @relation(fields: [requestId], references: [id], onDelete: Cascade)
  changedByUser User?   @relation(fields: [changedByUserId], references: [id])

  @@index([requestId])
}

model StaffNote {
  id        String   @id @default(cuid())
  requestId String
  userId    String
  note      String
  createdAt DateTime @default(now())

  request Request @relation(fields: [requestId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@index([requestId])
  @@index([userId])
}

model AuditLog {
  id           String   @id @default(cuid())
  userId       String?
  action       String
  entityType   String
  entityId     String?
  metadataJson Json?
  ipAddress    String?
  createdAt    DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([userId])
}